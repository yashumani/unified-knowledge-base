UKB_ENVIRONMENT=local
UKB_LOG_LEVEL=INFO

# Shared-secret auth. Every route except /health requires this token, sent as
# "Authorization: Bearer <token>" or "X-API-Token: <token>". Rotate away from
# the shipped default before exposing the API beyond localhost; the server logs
# a warning while it is unchanged.
UKB_API_TOKEN=dev-token-change-me
UKB_REQUIRE_AUTH=true

# Access policy. Objects above a caller's clearance are dropped before a
# context pack is composed. Without an identity provider every caller gets
# UKB_DEFAULT_USER_CLEARANCE; UKB_USER_CLEARANCES overrides per principal as
# "principal:level,principal:level". Levels: public, internal, confidential, restricted.
UKB_DEFAULT_USER_CLEARANCE=internal
UKB_USER_CLEARANCES=

# Approval is a human review gate. Leaving this false stops MCP agents from
# publishing knowledge into the brain.
UKB_MCP_ALLOW_APPROVAL=false

UKB_DATABASE_URL=sqlite:///./ukb-dev.db
UKB_OBJECT_STORE_URL=file://./.ukb/object-store
UKB_MCP_SERVER_NAME=unified-knowledge-base
UKB_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Local LLM enrichment for Unified Knowledge Base.
# Default development mode uses a locally running Ollama server.
UKB_AI_ENRICHMENT_ENABLED=true
UKB_AI_MODE=local_ai
UKB_AI_PROVIDER=ollama
UKB_AI_BASE_URL=http://localhost:11434
UKB_AI_CHAT_MODEL=llama3.1
UKB_AI_EMBEDDING_MODEL=embeddinggemma
UKB_AI_MAX_INPUT_CHARS=20000
UKB_AI_TIMEOUT_SECONDS=45
UKB_ALLOW_HOSTED_AI_FOR_RESTRICTED=false
UKB_STORE_AI_PROMPTS=false
UKB_STORE_AI_OUTPUTS=true

# Deterministic fallback for locked-down environments or CI.
# UKB_AI_MODE=offline_no_model
# UKB_AI_PROVIDER=noop
# UKB_AI_CHAT_MODEL=deterministic

# Hosted providers are intentionally not enabled for the UKB local demo path.
# Keep any hosted credentials server-side only if a private enterprise deployment adds them later.
# UKB_AI_PROVIDER=openai
# UKB_AI_MODE=hosted_ai
# UKB_OPENAI_MODEL=gpt-4o-mini
# UKB_OPENAI_API_KEY=replace-with-server-side-secret
