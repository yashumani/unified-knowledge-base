UKB_ENVIRONMENT=local
UKB_LOG_LEVEL=INFO
UKB_API_TOKEN=dev-token-change-me
UKB_DATABASE_URL=sqlite:///./ukb-dev.db
UKB_OBJECT_STORE_URL=file://./.ukb/object-store
UKB_MCP_SERVER_NAME=unified-knowledge-base
UKB_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# AI enrichment defaults are offline-safe. The noop provider performs deterministic
# enrichment and validation without network calls or secrets.
UKB_AI_ENRICHMENT_ENABLED=true
UKB_AI_MODE=offline_no_model
UKB_AI_PROVIDER=noop
UKB_AI_BASE_URL=http://localhost:11434
UKB_AI_CHAT_MODEL=deterministic
UKB_AI_EMBEDDING_MODEL=embeddinggemma
UKB_AI_MAX_INPUT_CHARS=20000
UKB_AI_TIMEOUT_SECONDS=45
UKB_ALLOW_HOSTED_AI_FOR_RESTRICTED=false
UKB_STORE_AI_PROMPTS=false
UKB_STORE_AI_OUTPUTS=true

# Optional hosted provider settings. Keep these server-side only.
# UKB_AI_PROVIDER=openai
# UKB_AI_MODE=hosted_ai
# UKB_OPENAI_MODEL=gpt-4o-mini
# UKB_OPENAI_API_KEY=replace-with-server-side-secret

# Optional local provider settings.
# UKB_AI_PROVIDER=ollama
# UKB_AI_MODE=local_ai
# UKB_AI_BASE_URL=http://localhost:11434
# UKB_AI_CHAT_MODEL=qwen3
