UKB_ENVIRONMENT=local
UKB_LOG_LEVEL=INFO

# Local compatibility token. Change it before exposing the API beyond localhost.
UKB_API_TOKEN=dev-token-change-me
UKB_REQUIRE_AUTH=true
UKB_DEFAULT_TENANT_ID=default
# Optional interim token-to-principal map. Production should use OIDC/SSO.
# Every principal must be bound to one tenant.
# UKB_API_TOKENS_JSON={"review-token":{"subject":"local.reviewer","tenant_id":"tenant-blue","roles":["consumer","submitter","reviewer"],"clearance":"internal"},"publish-token":{"subject":"local.publisher","tenant_id":"tenant-blue","roles":["consumer","publisher"],"clearance":"internal"}}
UKB_API_TOKENS_JSON={}
UKB_OIDC_ENABLED=false
UKB_OIDC_ISSUER=
UKB_OIDC_AUDIENCE=
UKB_OIDC_JWKS_URL=
UKB_OIDC_TENANT_CLAIM=tenant_id
UKB_DEFAULT_USER_CLEARANCE=internal
UKB_USER_CLEARANCES=
UKB_REVIEWER_ROLES=reviewer,governance_admin
UKB_PUBLISHER_ROLES=publisher,governance_admin
UKB_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Durable authoritative state and original evidence.
UKB_STORE_BACKEND=sqlalchemy
UKB_DATABASE_URL=sqlite+pysqlite:///./.ukb/ukb.db
UKB_OBJECT_STORE_URL=file://./.ukb/object-store
UKB_CREATE_SCHEMA_ON_STARTUP=true

# Source and evidence limits.
UKB_MAX_UPLOAD_BYTES=26214400
UKB_MAX_BATCH_FILES=250
UKB_MAX_ARCHIVE_BYTES=52428800
UKB_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
UKB_MAX_EXTRACTED_CHARS=2000000
UKB_EVIDENCE_CHUNK_CHARS=2200
UKB_EVIDENCE_CHUNK_OVERLAP=200
UKB_REQUIRE_OWNER_FOR_PUBLISH=true

# Local Ollama advisory compiler.
UKB_AI_ENRICHMENT_ENABLED=true
UKB_AI_MODE=local_ai
UKB_AI_PROVIDER=ollama
UKB_AI_BASE_URL=http://localhost:11434
UKB_AI_CHAT_MODEL=llama3.1
UKB_AI_EMBEDDING_MODEL=embeddinggemma
UKB_AI_MAX_INPUT_CHARS=100000
UKB_AI_TIMEOUT_SECONDS=45
UKB_AI_SCHEMA_VERSION=2.0
UKB_ALLOW_HOSTED_AI_FOR_RESTRICTED=false
UKB_STORE_AI_PROMPTS=false
UKB_STORE_AI_OUTPUTS=true

# Zvec is a disposable local index; SQL and object storage remain authoritative.
UKB_SEARCH_BACKEND=zvec
UKB_SEARCH_SYNC_ON_QUERY=true
UKB_ZVEC_PATH=./.ukb/zvec/approved-knowledge-v2
UKB_ZVEC_COLLECTION_NAME=ukb_approved_knowledge_v2

# Talk2Data temporal graph projection. SQL episodes and memory remain canonical.
UKB_TALK2DATA_GRAPH_BACKEND=memory
UKB_TALK2DATA_INDEX_LAG_TOLERANCE_SECONDS=300
# A deployment-specific adapter supplies the approved Graphiti client.
UKB_GRAPHITI_BASE_URL=
UKB_GRAPHITI_API_KEY=

# Governed static-web and Crawl4AI collection. Disabled until hosts are allowlisted.
UKB_WEB_CONNECTOR_ENABLED=false
UKB_WEB_ALLOWED_HOSTS=
UKB_WEB_ALLOWED_PORTS=80,443
UKB_WEB_ALLOW_PRIVATE_NETWORKS=false
UKB_WEB_RESPECT_ROBOTS=true
UKB_WEB_ROBOTS_FAIL_CLOSED=true
UKB_WEB_USER_AGENT=UKB-Knowledge-Connector/0.2
UKB_WEB_TIMEOUT_SECONDS=20
UKB_WEB_MAX_RESPONSE_BYTES=5242880
UKB_WEB_MAX_REDIRECTS=5

UKB_CRAWL4AI_ENABLED=false
UKB_CRAWL4AI_BASE_URL=http://crawl4ai:11235
UKB_CRAWL4AI_API_TOKEN=
UKB_CRAWL4AI_TIMEOUT_SECONDS=90
UKB_CRAWL4AI_MAX_PAGES=25

# Google Drive folder ingestion uses server-side credentials only.
UKB_GOOGLE_DRIVE_ENABLED=false
UKB_GOOGLE_DRIVE_ACCESS_TOKEN=
UKB_GOOGLE_DRIVE_TIMEOUT_SECONDS=30

UKB_MCP_SERVER_NAME=unified-knowledge-base
UKB_MCP_ALLOW_APPROVAL=false
UKB_MCP_ALLOW_PUBLICATION=false

# Deterministic CI/offline fallback:
# UKB_STORE_BACKEND=memory
# UKB_SEARCH_BACKEND=memory
# UKB_AI_MODE=offline_no_model
# UKB_AI_PROVIDER=noop
