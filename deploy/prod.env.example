# Copy to .env on the self-hosted runner deploy path.
# Do not commit real secrets or workplace-specific values.

UKB_ENVIRONMENT=prod
UKB_API_PORT=8000

# Required on every route except /health. Generate a unique value, for example
# `openssl rand -hex 32`, and keep it in the runner's secret store.
UKB_API_TOKEN=change-this-server-side-token
UKB_REQUIRE_AUTH=true

# Access policy. Keep the default clearance no higher than the least-privileged
# consumer, then grant specific principals upward.
UKB_DEFAULT_USER_CLEARANCE=internal
UKB_USER_CLEARANCES=

# Approval stays a human gate. Do not enable this in production.
UKB_MCP_ALLOW_APPROVAL=false

# GitHub Pages origin. Add your custom Pages/domain origin when configured.
UKB_CORS_ALLOW_ORIGINS=https://yashumani.github.io

# Local Ollama-backed enrichment. In Docker Compose, the API reaches Ollama by service name.
UKB_AI_ENRICHMENT_ENABLED=true
UKB_AI_MODE=local_ai
UKB_AI_PROVIDER=ollama
UKB_AI_BASE_URL=http://ollama:11434
UKB_AI_CHAT_MODEL=llama3.1
UKB_AI_EMBEDDING_MODEL=embeddinggemma
UKB_AI_MAX_INPUT_CHARS=20000
UKB_AI_TIMEOUT_SECONDS=45
UKB_STORE_AI_PROMPTS=false
UKB_STORE_AI_OUTPUTS=true
UKB_ALLOW_HOSTED_AI_FOR_RESTRICTED=false

# Current scaffold persistence. Replace with Postgres in the persistence phase.
UKB_DATABASE_URL=sqlite:///./ukb-dev.db
UKB_OBJECT_STORE_URL=file://./.ukb/object-store
UKB_MCP_SERVER_NAME=unified-knowledge-base
