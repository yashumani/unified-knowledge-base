# Copy to .env on the self-hosted runner deploy path.
# Populate secret values only on the runtime machine.

UKB_ENVIRONMENT=prod
UKB_API_PORT=8000
UKB_API_TOKEN=
UKB_POSTGRES_PASSWORD=

UKB_CORS_ALLOW_ORIGINS=https://yashumani.github.io

UKB_STORE_BACKEND=sqlalchemy
UKB_OBJECT_STORE_URL=file://./.ukb/object-store

UKB_AI_ENRICHMENT_ENABLED=true
UKB_AI_MODE=local_ai
UKB_AI_PROVIDER=ollama
UKB_AI_BASE_URL=http://ollama:11434
UKB_AI_CHAT_MODEL=llama3.1
UKB_AI_EMBEDDING_MODEL=embeddinggemma
UKB_AI_MAX_INPUT_CHARS=20000
UKB_AI_TIMEOUT_SECONDS=45
UKB_STORE_AI_PROMPTS=false
UKB_STORE_AI_OUTPUTS=true
UKB_ALLOW_HOSTED_AI_FOR_RESTRICTED=false

# Derived local search index. PostgreSQL remains authoritative.
UKB_SEARCH_BACKEND=zvec
UKB_SEARCH_SYNC_ON_QUERY=true
UKB_ZVEC_PATH=/app/.ukb/zvec/approved-knowledge
UKB_ZVEC_COLLECTION_NAME=ukb_approved_knowledge

# Keep URL collection disabled until approved source hosts are configured.
UKB_WEB_CONNECTOR_ENABLED=false
UKB_WEB_ALLOWED_HOSTS=
UKB_WEB_ALLOWED_PORTS=80,443
UKB_WEB_ALLOW_PRIVATE_NETWORKS=false
UKB_WEB_RESPECT_ROBOTS=true
UKB_WEB_ROBOTS_FAIL_CLOSED=true
UKB_WEB_USER_AGENT=UKB-Knowledge-Connector/0.1
UKB_WEB_TIMEOUT_SECONDS=20
UKB_WEB_MAX_RESPONSE_BYTES=5242880
UKB_WEB_MAX_REDIRECTS=5

UKB_MCP_SERVER_NAME=unified-knowledge-base
