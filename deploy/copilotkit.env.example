# Unified Knowledge Base CopilotKit v0.8 private runtime

COPILOTKIT_MODEL=llama3.1
COPILOTKIT_MAX_STEPS=8
COPILOTKIT_MAX_OUTPUT_TOKENS=1600
COPILOTKIT_REQUIRE_AUTH=true
COPILOTKIT_RUNTIME_TOKEN=replace-with-a-long-random-secret
COPILOTKIT_ALLOWED_ORIGINS=https://yashumani.github.io
COPILOTKIT_TELEMETRY_DISABLED=true
COPILOTKIT_BIND_ADDRESS=127.0.0.1
COPILOTKIT_PORT=8200

# OpenAI-compatible Ollama endpoint uses a non-secret placeholder API key.
COPILOTKIT_OLLAMA_API_KEY=ollama-local

# Least-privilege service identity for the CopilotKit-connected MCP process.
UKB_MCP_SUBJECT=copilotkit-service
UKB_MCP_TENANT_ID=default
UKB_MCP_ROLES=consumer
UKB_MCP_CLEARANCE=internal
UKB_MCP_ALLOW_SUBMISSION=false
UKB_MCP_ALLOW_REVIEW_QUEUE=false
UKB_MCP_BIND_ADDRESS=127.0.0.1
UKB_MCP_PORT=8765
