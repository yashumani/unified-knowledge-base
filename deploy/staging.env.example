# Private staging runtime template.
# Copy to the self-hosted runner deployment directory as .env and replace every placeholder.
UKB_ENVIRONMENT=stage
UKB_API_IMAGE=ghcr.io/yashumani/unified-knowledge-base-api:v0.4.0
UKB_API_PORT=8000

UKB_API_TOKEN=replace-with-a-long-random-local-break-glass-token
UKB_DEFAULT_TENANT_ID=replace-pilot-tenant
UKB_API_TOKENS_JSON={"replace-with-a-long-random-review-token":{"subject":"pilot.reviewer@example.org","tenant_id":"replace-pilot-tenant","roles":["consumer","submitter","reviewer"],"clearance":"internal"},"replace-with-a-long-random-publish-token":{"subject":"pilot.publisher@example.org","tenant_id":"replace-pilot-tenant","roles":["consumer","publisher"],"clearance":"internal"}}
UKB_REQUIRE_AUTH=true
UKB_OIDC_ENABLED=false
UKB_OIDC_ISSUER=
UKB_OIDC_AUDIENCE=
UKB_OIDC_JWKS_URL=
UKB_OIDC_TENANT_CLAIM=tenant_id
UKB_DEFAULT_USER_CLEARANCE=internal
UKB_USER_CLEARANCES=
UKB_CORS_ALLOW_ORIGINS=https://yashumani.github.io

UKB_POSTGRES_DB=ukb
UKB_POSTGRES_USER=ukb
UKB_POSTGRES_PASSWORD=replace-with-a-long-random-database-password
UKB_STORE_BACKEND=sqlalchemy
UKB_CREATE_SCHEMA_ON_STARTUP=false
UKB_OBJECT_STORE_URL=file:///app/.ukb/object-store

UKB_SEARCH_BACKEND=zvec
UKB_SEARCH_SYNC_ON_QUERY=true
UKB_ZVEC_COLLECTION_NAME=ukb_approved_knowledge_v2

# SQL episodes and governed memory remain canonical. Graphiti is optional.
UKB_TALK2DATA_GRAPH_BACKEND=memory
UKB_TALK2DATA_INDEX_LAG_TOLERANCE_SECONDS=300
UKB_GRAPHITI_BASE_URL=
UKB_GRAPHITI_API_KEY=

UKB_AI_ENRICHMENT_ENABLED=true
UKB_AI_MODE=local_ai
UKB_AI_PROVIDER=ollama
UKB_AI_CHAT_MODEL=llama3.1
UKB_AI_EMBEDDING_MODEL=embeddinggemma
UKB_AI_TIMEOUT_SECONDS=45
UKB_AI_SCHEMA_VERSION=2.0
UKB_STORE_AI_PROMPTS=false
UKB_STORE_AI_OUTPUTS=true

UKB_CRAWL4AI_IMAGE=unclecode/crawl4ai:0.8.8
UKB_CRAWL4AI_ENABLED=false
UKB_CRAWL4AI_API_TOKEN=
UKB_CRAWL4AI_SHM_SIZE=1gb
UKB_WEB_ALLOWED_HOSTS=
UKB_WEB_ALLOWED_PORTS=80,443
UKB_WEB_ALLOW_PRIVATE_NETWORKS=false
UKB_WEB_RESPECT_ROBOTS=true
UKB_WEB_ROBOTS_FAIL_CLOSED=true

UKB_GOOGLE_DRIVE_ENABLED=false
UKB_GOOGLE_DRIVE_ACCESS_TOKEN=

UKB_MCP_ALLOW_APPROVAL=false
UKB_MCP_ALLOW_PUBLICATION=false
