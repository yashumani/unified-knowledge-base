VITE_UKB_API_BASE_URL=http://localhost:8000

# Must match the backend's UKB_API_TOKEN. Vite inlines this into the client
# bundle at build time, so it is only safe for local or trusted-network use.
# Do not ship a real token to a public GitHub Pages build; point Pages at demo
# mode instead, or move to per-user SSO before exposing a live backend.
VITE_UKB_API_TOKEN=dev-token-change-me
