VITE_UKB_API_BASE_URL=http://localhost:8000

# Must match the backend's UKB_API_TOKEN. Vite inlines this into the client
# bundle at build time, so it is only safe for local or trusted-network use.
# Do not ship a real token to a public GitHub Pages build; point Pages at demo
# mode instead, or move to per-user SSO before exposing a live backend.
VITE_UKB_API_TOKEN=dev-token-change-me

# Optional self-hosted CopilotKit runtime. When omitted, the OpenWebUI-adapted
# application keeps the existing governed Context Pack flow and does not load an
# external agent runtime.
VITE_COPILOTKIT_RUNTIME_URL=http://localhost:8200/api/copilotkit
VITE_COPILOTKIT_AGENT_ID=default

# Local/trusted-network development only. A Vite variable is embedded in the
# browser bundle; public deployments should forward a per-user OIDC token rather
# than shipping a shared runtime secret.
VITE_COPILOTKIT_RUNTIME_TOKEN=
