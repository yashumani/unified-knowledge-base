    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "ingestion_timestamp": {
      "format": "date-time",
      "title": "Ingestion Timestamp",
      "type": "string"
    },
    "metadata": {
