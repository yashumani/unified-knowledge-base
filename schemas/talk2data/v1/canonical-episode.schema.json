    "raw_content": {
      "title": "Raw Content",
      "type": "string"
    },
    "source_checksum": {
      "default": "",
      "title": "Source Checksum",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "title": "Source Type",
      "type": "string"
    },
